RewriteEngine On

# Hide /public when someone opens the public directory directly.
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/public/ [NC]
RewriteRule ^(.+)$ /MainWebsite/$1 [R=301,L]

# Canonical redirects from old PHP page URLs to clean public URLs.
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/index\.php[?\s] [NC]
RewriteRule ^index\.php$ ./ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/chatbotShowcase\.php[?\s] [NC]
RewriteRule ^chatbotShowcase\.php$ chatbots [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/favouritesShowcase\.php[?\s] [NC]
RewriteRule ^favouritesShowcase\.php$ favourites [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/aboutUs\.php[?\s] [NC]
RewriteRule ^aboutUs\.php$ about-us [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/affiliateDisclosure\.php[?\s] [NC]
RewriteRule ^affiliateDisclosure\.php$ affiliate-disclosure [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/privacyPolicy\.php[?\s] [NC]
RewriteRule ^privacyPolicy\.php$ privacy-policy [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/termsAndConditions\.php[?\s] [NC]
RewriteRule ^termsAndConditions\.php$ terms-and-conditions [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/submitChatbot\.php[?\s] [NC]
RewriteRule ^submitChatbot\.php$ submit-chatbot [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/forgotPassword\.php[?\s] [NC]
RewriteRule ^forgotPassword\.php$ forgot-password [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/resetPassword\.php[?\s] [NC]
RewriteRule ^resetPassword\.php$ reset-password [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/verificationSent\.php[?\s] [NC]
RewriteRule ^verificationSent\.php$ verification-sent [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/verifyEmail\.php[?\s] [NC]
RewriteRule ^verifyEmail\.php$ verify-email [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/payment-success\.php[?\s] [NC]
RewriteRule ^payment-success\.php$ payment-success [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/googleAuth\.php[?\s] [NC]
RewriteRule ^googleAuth\.php$ google-auth [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/googleCallback\.php[?\s] [NC]
RewriteRule ^googleCallback\.php$ google-callback [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/contact\.php[?\s] [NC]
RewriteRule ^contact\.php$ contact [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/advertise\.php[?\s] [NC]
RewriteRule ^advertise\.php$ advertise [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/checkout\.php[?\s] [NC]
RewriteRule ^checkout\.php$ checkout [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/login\.php[?\s] [NC]
RewriteRule ^login\.php$ login [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/logout\.php[?\s] [NC]
RewriteRule ^logout\.php$ logout [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/signUp\.php[?\s] [NC]
RewriteRule ^signUp\.php$ sign-up [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/profile\.php[?\s] [NC]
RewriteRule ^profile\.php$ profile [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/admin\.php[?\s] [NC]
RewriteRule ^admin\.php$ admin [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*/unsubscribe\.php[?\s] [NC]
RewriteRule ^unsubscribe\.php$ unsubscribe [R=301,L]

# Accept trailing slashes, but keep one canonical URL per page.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ $1 [R=301,L]

RewriteCond %{THE_REQUEST} \s(/[^?\s]*\.php)/[^\s?]
RewriteRule ^ %1 [R=301,L]

# Clean public page routes.
RewriteRule ^$ index.php [L]
RewriteRule ^chatbots$ chatbotShowcase.php [L,QSA]
RewriteRule ^favourites$ favouritesShowcase.php [L,QSA]
RewriteRule ^about-us$ aboutUs.php [L,QSA]
RewriteRule ^affiliate-disclosure$ affiliateDisclosure.php [L,QSA]
RewriteRule ^privacy-policy$ privacyPolicy.php [L,QSA]
RewriteRule ^terms-and-conditions$ termsAndConditions.php [L,QSA]
RewriteRule ^submit-chatbot$ submitChatbot.php [L,QSA]
RewriteRule ^forgot-password$ forgotPassword.php [L,QSA]
RewriteRule ^reset-password$ resetPassword.php [L,QSA]
RewriteRule ^verification-sent$ verificationSent.php [L,QSA]
RewriteRule ^verify-email$ verifyEmail.php [L,QSA]
RewriteRule ^payment-success$ payment-success.php [L,QSA]
RewriteRule ^google-auth$ googleAuth.php [L,QSA]
RewriteRule ^google-callback$ googleCallback.php [L,QSA]
RewriteRule ^contact$ contact.php [L,QSA]
RewriteRule ^advertise$ advertise.php [L,QSA]
RewriteRule ^checkout$ checkout.php [L,QSA]
RewriteRule ^login$ login.php [L,QSA]
RewriteRule ^logout$ logout.php [L,QSA]
RewriteRule ^sign-up$ signUp.php [L,QSA]
RewriteRule ^profile$ profile.php [L,QSA]
RewriteRule ^admin$ admin.php [L,QSA]
RewriteRule ^unsubscribe$ unsubscribe.php [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
RewriteRule ^contact-submit$ app/contactActions.php [L,QSA]
RewriteRule ^404$ 404.php [L,QSA]
RewriteRule ^500$ 500.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.php [L]

ErrorDocument 404 /404.php
ErrorDocument 500 /500.php
